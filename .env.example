# SonarFix settings. Copy to `.env` and fill in. Never commit `.env`.
# (The packaged SonarFix.exe has a Settings page that writes these for you.)

# --- SonarQube (required) ----------------------------------------------------
# Self-hosted: https://sonar.yourcompany.com    SonarCloud: https://sonarcloud.io
SONAR_URL=
# My Account > Security > Generate Token
SONAR_TOKEN=
# SonarCloud only; leave blank for self-hosted SonarQube
SONAR_ORG=

# --- AI engine ----------------------------------------------------------------
# claude-code  uses your Claude Code login (SSO / subscription), no API key needed.
#              Needs the CLI:  npm install -g @anthropic-ai/claude-code   then   claude auth login
# deepagents   LangGraph agents; needs ANTHROPIC_API_KEY below, or a local model.
SONARFIX_ENGINE=claude-code
# Model used for analysis and fixes. Can also be switched from the Settings page.
SONARFIX_MODEL=claude-sonnet-5-5
# default | acceptEdits | bypassPermissions   (claude-code only; it runs headless)
SONARFIX_CLAUDE_CODE_PERMISSION_MODE=acceptEdits
# Most occurrences sent to one AI session - caps token spend per group.
SONARFIX_MAX_AI_OCCURRENCES=20

# deepagents engine only:
# ANTHROPIC_API_KEY=
# Local model instead of Claude:
# SONARFIX_LLM_PROVIDER=ollama                  (or openai-compatible)
# SONARFIX_MODEL=qwen2.5-coder:14b
# SONARFIX_LLM_BASE_URL=http://localhost:11434  (openai-compatible: http://localhost:8000/v1)
# SONARFIX_LLM_API_KEY=not-needed               (openai-compatible only)

# --- Pull requests (the PR goes to the clone's `origin` remote) ----------------
# Bitbucket Cloud / Server / Data Center
BITBUCKET_TOKEN=
BITBUCKET_USERNAME=
# Server/DC base URL, only if it can't be read from the remote (e.g. an SSH remote)
# BITBUCKET_URL=https://bitbucket.yourcompany.com

# Azure DevOps Repos - personal access token with Code (Read & write) scope
AZURE_DEVOPS_TOKEN=

# --- Build verification --------------------------------------------------------
# Build the changed projects (and what depends on them) before a PR is offered.
SONARFIX_BUILD_ENABLED=true
# Seconds allowed per build or test command
SONARFIX_BUILD_TIMEOUT=300

# --- Optional: SonarQube MCP server (off | stdio | http) -----------------------
# Lets the AI query SonarQube while analysing. SONAR_URL / SONAR_TOKEN / SONAR_ORG
# are forwarded to it. SonarFix does not install this server.
SONARFIX_SONAR_MCP=off
# stdio:
# SONARFIX_SONAR_MCP=stdio
# SONARFIX_SONAR_MCP_COMMAND=java
# SONARFIX_SONAR_MCP_ARGS=-jar C:/tools/sonarqube-mcp-server.jar
# http:
# SONARFIX_SONAR_MCP=http
# SONARFIX_SONAR_MCP_URL=http://localhost:9000/mcp

# --- Local ---------------------------------------------------------------------
# SQLite database (the .exe uses %LOCALAPPDATA%\SonarFix instead)
SONARFIX_DB=data/sonarfix.db
# Lines of code shown around the flagged line when analysing
SONARFIX_CONTEXT_RADIUS=40
