# =============================================================================
# SonarQube  (always required - SonarFix reads issues over the REST API)
# =============================================================================
# Self-hosted: https://sonar.yourcompany.com   SonarCloud: https://sonarcloud.io
SONAR_URL=https://sonarcloud.io
# User token from  My Account > Security > Generate Token
SONAR_TOKEN=
# SonarCloud only; leave blank for self-hosted SonarQube
SONAR_ORG=

# =============================================================================
# LLM provider  -  anthropic | ollama | openai-compatible
# =============================================================================
SONARFIX_LLM_PROVIDER=anthropic

# --- anthropic (default) -----------------------------------------------------
ANTHROPIC_API_KEY=
SONARFIX_MODEL=claude-opus-5

# --- ollama ------------------------------------------------------------------
# SONARFIX_LLM_PROVIDER=ollama
# SONARFIX_MODEL=qwen2.5-coder:14b
# SONARFIX_LLM_BASE_URL=http://localhost:11434

# --- openai-compatible (vLLM, LM Studio, llama.cpp, LiteLLM, ...) ------------
# SONARFIX_LLM_PROVIDER=openai-compatible
# SONARFIX_MODEL=qwen2.5-coder-32b-instruct
# SONARFIX_LLM_BASE_URL=http://localhost:8000/v1
# SONARFIX_LLM_API_KEY=not-needed
#
# Both agents need reliable tool calling and JSON-schema output. Pick a local
# model advertised as tool-calling capable, or the agent will loop without
# ever reading a file. Verify with:  sonarfix check --live

# =============================================================================
# Agent engine  -  deepagents | claude-code
# =============================================================================
# deepagents   LangGraph + deepagents, works with every provider above
# claude-code  the Claude Agent SDK driving the Claude Code CLI.
#              Requires SONARFIX_LLM_PROVIDER=anthropic and the CLI installed:
#                  npm install -g @anthropic-ai/claude-code
SONARFIX_ENGINE=deepagents
# default | acceptEdits | bypassPermissions  (claude-code only; runs headless,
# so it must not be a mode that waits for a human at a terminal)
SONARFIX_CLAUDE_CODE_PERMISSION_MODE=acceptEdits

# =============================================================================
# SonarQube MCP server  (optional)  -  off | stdio | http
# =============================================================================
# Gives the analyst agent live access to SonarQube as tools, so it can ask
# follow-up questions instead of working only from the issue we pre-fetched.
# SonarFix does not manage this server; point it at one you run.
# SONAR_URL / SONAR_TOKEN / SONAR_ORG above are forwarded to it automatically.
SONARFIX_SONAR_MCP=off

# stdio - SonarFix starts the server as a subprocess.
# Args accept a JSON list or a shell-style string.
# SONARFIX_SONAR_MCP=stdio
# SONARFIX_SONAR_MCP_COMMAND=docker
# SONARFIX_SONAR_MCP_ARGS=run -i --rm -e SONARQUBE_URL -e SONARQUBE_TOKEN mcp/sonarqube

# http - SonarFix connects to a server you already run.
# SONARFIX_SONAR_MCP=http
# SONARFIX_SONAR_MCP_URL=http://localhost:9000/mcp

# =============================================================================
# Bitbucket  (push the fix branch and open a pull request)
# =============================================================================
# The PR goes to the repo in the local clone's `origin` remote. Works with
# Bitbucket Cloud (bitbucket.org) and Bitbucket Server / Data Center.
# Token: a repository or project access token (sent as a Bearer header).
BITBUCKET_TOKEN=BBDC-MDM0MTM1MjAxNjYwOhuR01m+tlb7nAdARD8CvQkHfv/p
# Only for basic auth (Bitbucket Cloud app passwords / API tokens): your username.
BITBUCKET_USERNAME=YadavRos
# Server/DC base URL, only needed if it cannot be read from the remote (e.g. SSH).
# BITBUCKET_URL=https://bitbucket.yourcompany.com

# Most occurrences sent to one AI session - caps token spend per group.
SONARFIX_MAX_AI_OCCURRENCES=20

# =============================================================================
# Local
# =============================================================================
SONARFIX_DB=data/sonarfix.db
SONARFIX_API_URL=http://127.0.0.1:8000
# Lines of code shown above/below the offending line when analysing
SONARFIX_CONTEXT_RADIUS=40
